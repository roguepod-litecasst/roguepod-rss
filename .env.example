# Copy to .env and fill in. .env is gitignored - never commit it.
# Load with:  set -a && source .env && set +a
#
# Inside GitHub Actions none of this is needed: GITHUB_REPOSITORY and
# GITHUB_TOKEN are provided automatically.

PODCAST_FEED_URL=https://feeds.acast.com/public/shows/roguepod-litecast

# --- GitHub (the only host) ---
# owner/name of the public repo. Audio goes to the release tagged
# $RELEASE_TAG; feed.xml and state/manifest.json are committed to this repo
# and served by GitHub Pages.
GITHUB_REPOSITORY=roguepod-litecasst/podcast-mirror
# A token with contents:write on that repo. Locally: GITHUB_TOKEN=$(gh auth token)
GITHUB_TOKEN=
# RELEASE_TAG=audio

# Public URL prefixes are derived from GITHUB_REPOSITORY:
#   audio -> https://github.com/<owner>/<name>/releases/download/<tag>
#   feed  -> https://<owner>.github.io/<name>
# Override only if you host one of them elsewhere. No trailing slash.
# AUDIO_PUBLIC_BASE_URL=
# FEED_PUBLIC_BASE_URL=

# --- Cloudflare R2 fallback (only if GitHub's octet-stream content-type
#     turns out to matter to YouTube; see PRD.md) ---
# STORAGE_BUCKET=
# R2_ACCOUNT_ID=
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
# AUDIO_PUBLIC_BASE_URL=https://pub-xxxx.r2.dev/audio
