# Copy to .env and fill in. .env is gitignored - never commit it.
# Load with:  set -a && source .env && set +a

PODCAST_FEED_URL=https://feeds.acast.com/public/shows/roguepod-litecast

# --- Bunny.net (see README "Setup") ---
# The storage zone NAME doubles as the bucket and the access key id.
STORAGE_BUCKET=roguepod-mirror
STORAGE_ENDPOINT_URL=https://la-s3.storage.bunnycdn.com
STORAGE_REGION=la

# Public URL served by the pull zone, via your CNAME. No trailing slash.
STORAGE_PUBLIC_BASE_URL=https://mirror.roguepod.show

# --- credentials: Storage Zone -> Access tab (SENSITIVE) ---
STORAGE_ACCESS_KEY_ID=roguepod-mirror
STORAGE_SECRET_ACCESS_KEY=

# --- Cloudflare R2 instead? Drop the three STORAGE_ lines above and set: ---
# R2_ACCOUNT_ID=
